{
    "name": "elephentity/wordpress",
    "description": "WordPress storage adaptor for Elephentity. The only package permitted to reference WP symbols.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "elephentity/runtime": "dev-main"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.7 || ^7.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Eleph\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eleph\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "ci": [
            "@style",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
